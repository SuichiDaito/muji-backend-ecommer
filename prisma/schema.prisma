// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model Role_type {
  id        Int      @id @default(autoincrement())
  name_role     String
  status  Boolean @default(true)  
  
  profile Profiles[]
}
model Profiles {
  id Int @id @default(autoincrement())
  id_role Int 
  name String
  gender Boolean
  date DateTime
  address String
  email String @unique
  password String
  phone String 
  refresh_token String? 
  revoked Boolean @default(false)
  created_at DateTime @default(now())
  updated_at DateTime?

  role Role_type @relation(fields: [id_role], references: [id])

  cards Cards[]
  orders Orders[]
}

model Cards {
  id        Int      @id @default(autoincrement())
  id_user Int
  status  Boolean @default(true)   
  created_at DateTime @default(now())
  updated_at DateTime?

  user Profiles @relation(fields: [id_user], references: [id])
  card_items Card_items[]
}

model Product_type {
  id        Int      @id @default(autoincrement())
  name     String
  status  Boolean @default(true)   

  product Products[]
}

model Color_type {
  id        Int      @id @default(autoincrement())
  name     String
  status  Boolean @default(true)
  
  product Products[] 
}

model Size_type {
  id        Int      @id @default(autoincrement())
  name     String
  status  Boolean @default(true)   

  product Products[] 
}

model Products {
  id Int @id @default(autoincrement())
  id_type Int 
  id_color Int 
  id_size Int 
  name String
  price_original Int 
  created_at DateTime @default(now())
  updated_at DateTime?

  type Product_type @relation(fields: [id_type], references: [id])
  color Color_type @relation(fields: [id_color], references: [id])
  size Size_type @relation(fields: [id_size], references: [id])
  card_items Card_items[]
  order_items Order_items[]
}

model Card_items {
  id Int @id @default(autoincrement())
  id_card Int
  id_product Int 
  name_product String
  size_product String
  color_product String
  price_original Int 
  quantity Int 
  subtotal_amount Int
  is_selected Boolean 
  created_at DateTime @default(now())
  updated_at DateTime?

  card Cards @relation(fields: [id_card], references: [id])
  product Products @relation(fields: [id_product], references: [id])

}

model Payment_type {
  id        Int      @id @default(autoincrement())
  name     String
  status  Boolean @default(true)   

  orders Orders[]
}

model Orders {
  id        Int      @id @default(autoincrement())
  id_user Int
  id_payment Int
  created_at DateTime @default(now())
  updated_at DateTime?

  payment Payment_type @relation(fields: [id_payment], references: [id])
  profile Profiles @relation(fields: [id_user], references: [id])
  order_items Order_items[]
}

model Order_items {
  id Int @id @default(autoincrement())
  id_order Int
  id_product Int 
  name_product String
  color_product String
  size_product String
  quantity Int 
  price_original Int 
  name_payment String 
  gross_amount Int
  vat_amount Int
  net_amount Int

  orders Orders @relation(fields: [id_order], references:[id])
  product Products @relation(fields: [id_product], references: [id])
}









